# Copy to .env and fill in. Both values are publishable, read-only keys;
# they are only used by the build-time data step (scripts/generate-projects.mjs).
# See docs/environment.md. Never put a service-role key or database password here.

SUPABASE_URL="https://<your-project>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"

# Client-side equivalents (Vite exposes these to the bundle).
VITE_SUPABASE_URL="https://<your-project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
